# Copy this file to .env.local and fill in real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use a hosted PostgreSQL database for Vercel (Neon/Supabase/other PostgreSQL provider).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
BAZARDOR_API_BASE_URL="https://api.api-store.workers.dev/api/bazardor"
